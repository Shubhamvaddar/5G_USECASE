# ============================================================
# SolarTwin 5G — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
#
# --- Serial Ports ---
# Windows:  TEMPERATURE_PORT=COM21   LIGHT_PORT=COM20
# Fedora:   TEMPERATURE_PORT=/dev/ttyUSB1   LIGHT_PORT=/dev/ttyUSB0
#
# To identify ports on Fedora, run:
#   ls /dev/ttyUSB*
#   dmesg | grep ttyUSB
# If permission denied: sudo usermod -aG dialout $USER  (then re-login)
# ============================================================

APP_NAME=SolarTwin 5G
APP_VERSION=0.1.0

# SQLite database path (relative to backend/ directory)
DATABASE_URL=sqlite:///./solartwin.db

# --- Temperature Sensor (CP2102 USB-to-UART, JSON output) ---
TEMPERATURE_PORT=COM21
TEMPERATURE_BAUDRATE=115200
# Read timeout in seconds for each serial.readline() call
TEMPERATURE_READ_TIMEOUT=2.0
# Seconds to wait before attempting reconnect after disconnection
TEMPERATURE_RECONNECT_DELAY=5.0

# --- Light Sensor (CP2102 USB-to-UART, BH1750 ambient light sensor) ---
LIGHT_PORT=COM20
LIGHT_BAUDRATE=9600
LIGHT_READ_TIMEOUT=2.0
LIGHT_RECONNECT_DELAY=5.0
# Max raw bytes to log per diagnostic sample (prevents flooding logs)
LIGHT_DIAG_SAMPLE_BYTES=64

# --- Data Acquisition ---
# Interval between readings in seconds
COLLECTION_INTERVAL=5

# --- FastAPI Server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/solartwin.log
